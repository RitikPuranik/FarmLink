// FarmLink Intelligence — Module 1: Authentication & RBAC
//           + Module 2: Farmer & Farm Profile Management
// Prisma schema. Module 1 (User/Session/PasswordResetToken/OtpChallenge/
// AuditLog) is untouched except for one additive back-relation on User
// (`farmerProfile`) required by Prisma for the new 1:1 relation — no
// existing Module 1 field, index, or behavior changes.
// Designed to be extended by future modules (FPOProfile, BuyerProfile,
// TransporterProfile, WarehouseProfile, etc.) without touching this core.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  FARMER
  FPO_ADMIN
  BUYER
  TRANSPORTER
  WAREHOUSE_OPERATOR
  ADMIN
  GOVERNMENT_VIEWER
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Language {
  en
  hi
  mr
}

// ---------------------------------------------------------------------------
// Module 2 enums
// ---------------------------------------------------------------------------

enum IrrigationType {
  RAINFED
  CANAL
  BOREWELL
  DRIP
  SPRINKLER
  MIXED
  OTHER
  NOT_SPECIFIED
}

enum AreaUnit {
  ACRE
  HECTARE
}

enum FpoMembershipStatus {
  NOT_A_MEMBER
  MEMBER
  PENDING
}

enum LiquidityPreference {
  URGENT
  WITHIN_3_DAYS
  WITHIN_1_WEEK
  CAN_WAIT_2_WEEKS
  FLEXIBLE
}

enum CommunicationPreference {
  IN_APP
  SMS
  WHATSAPP
  VOICE
}

// ---------------------------------------------------------------------------
// Module 3 enums — FPO Management & Farmer Aggregation
// ---------------------------------------------------------------------------

enum FpoOrganizationType {
  FPO
  FPC
  COOPERATIVE
  OTHER
}

// Deliberately its own enum rather than reusing Module 1's VerificationStatus
// (User.phoneVerificationStatus etc.): that enum's PENDING/VERIFIED/REJECTED/
// EXPIRED already carries a specific identity-verification meaning, and an
// FPO's registration-review workflow needs an extra UNDER_REVIEW step plus a
// SUSPENDED value the User verification concept has no equivalent for.
// Coupling the two would make a future change to one silently affect the
// other for no shared benefit.
enum FpoVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

// Operational status of the FPO account itself (can it be used at all right
// now), distinct from verificationStatus (has the org been vetted). A
// SUSPENDED/DEACTIVATED FPO blocks normal member-management/aggregation
// operations regardless of how "verified" it is on paper.
enum FpoAccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum FpoAdminRole {
  PRIMARY_ADMIN
  ADMIN
}

enum FpoAdminStatus {
  ACTIVE
  INACTIVE
}

// Lifecycle of a single farmer's membership *request/record* at one FPO.
// Named distinctly from the existing FpoMembershipStatus enum above (which
// is Module 2's much simpler farmer-self-declared NOT_A_MEMBER/MEMBER/
// PENDING answer on FarmerProfile) — the two are intentionally not merged;
// see FarmerProfile's fpoMembershipStatus field comment and
// modules/fpo/README for how they relate.
enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  REMOVED
}

enum AggregationGroupStatus {
  DRAFT
  OPEN
  READY
  CLOSED
  CANCELLED
}

// Internal normalization unit is KG (see modules/fpo/unit-conversion.ts);
// this enum is what callers/API responses are allowed to request/display in.
enum QuantityUnit {
  KG
  QTL
  TONNE
}

// ---------------------------------------------------------------------------
// Module 4 enums — Crop / Lot Management
// ---------------------------------------------------------------------------

// Build spec section 8/27: a controlled state machine — clients never set
// this string directly (see lots.schemas.ts); every transition goes through
// LotStatusService/CropLotRepository.transition().
enum CropLotStatus {
  DRAFT
  AVAILABLE
  PARTIALLY_COMMITTED
  COMMITTED
  STORED
  IN_TRANSACTION
  DELIVERED
  COMPLETED
  CANCELLED
}

// Build spec section 6/32: who the lot's produce belongs to right now.
// Deliberately its own enum rather than reusing FpoMembershipStatus/
// FpoAdminRole/etc. — "who owns this lot" has nothing to do with either of
// those lifecycles.
enum LotOwnerType {
  FARMER
  FPO
}

// Build spec section 16/54: how the lot came to exist, kept distinct from
// ownerType — an FPO-owned lot is always FPO_AGGREGATED today, but the two
// concepts are recorded separately so a future per-member-contribution lot
// type doesn't have to overload ownerType to express it.
enum LotSourceType {
  FARMER_CREATED
  FPO_AGGREGATED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  fullName     String
  mobile       String        @unique
  email        String?       @unique
  buyerProfile BuyerProfile?
  passwordHash String

  role          UserRole
  accountStatus AccountStatus @default(PENDING_VERIFICATION)

  phoneVerificationStatus    VerificationStatus @default(PENDING)
  emailVerificationStatus    VerificationStatus @default(PENDING)
  identityVerificationStatus VerificationStatus @default(PENDING)

  preferredLanguage Language @default(en)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions            Session[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  otpChallenges       OtpChallenge[]

  // Module 2. One-to-one; a FARMER gets at most one FarmerProfile. Every
  // other Module 1 field/relation above this line is unchanged.
  farmerProfile FarmerProfile?

  // Module 3. A user with role FPO_ADMIN can administer zero or more FPOs
  // (and in principle a non-FPO_ADMIN user could hold a legacy/former
  // FpoAdmin row too — role alone is never trusted for authorization, see
  // modules/fpo/fpo.authorization.ts) — kept as its own join model rather
  // than a single fpoId on User because an admin may manage more than one
  // FPO and an FPO may have more than one admin.
  fpoAdminRoles FpoAdmin[]

  // Module 4. Who changed a lot's status — purely for LotStatusHistory
  // display ("changed by Ramesh Patil"); never required, never a second
  // source of truth for identity.
  lotStatusChanges LotStatusHistory[]

  // Module 8
  sellStoreDecisions SellStoreDecision[]

  // Module 9 — a WAREHOUSE_OPERATOR (or any user acting individually,
  // never trusted from role alone — see WarehouseOwnerType) may own zero
  // or more warehouses directly, as opposed to warehouses owned by an Fpo.
  ownedWarehouses Warehouse[]

  @@index([mobile])
  @@index([email])
  @@index([publicId])
  @@index([role])
  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String

  // Hash of the long-lived refresh token secret. Raw secret is never stored.
  tokenHash String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Future-ready OTP challenge storage. Backs the OtpProvider abstraction
// (MockOtpProvider today, FutureSmsOtpProvider later) without committing to
// a real SMS vendor yet.
model OtpChallenge {
  id     String  @id @default(uuid())
  userId String?

  destination String // mobile number or email the OTP was issued for
  purpose     String // e.g. "PHONE_VERIFICATION", "LOGIN_2FA"
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([destination, purpose])
  @@map("otp_challenges")
}

model AuditLog {
  id          String  @id @default(uuid())
  actorUserId String?

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Module 2 — Farmer & Farm Profile Management
//
// Relationship shape (see build spec section 43):
//
//   User (Module 1, unchanged)
//     └── FarmerProfile (1:1)
//           ├── Farm[]        — a farmer may have multiple farms
//           │     └── FarmerCrop[]
//           └── Fpo (optional reference)
//
//   Crop
//     ├── CropTranslation[]   — en/hi/mr display names, not duplicate crops
//     └── FarmerCrop[]
//
//   State → District → Taluka — normalized location reference data,
//   seeded for Maharashtra only for the current SIH scope but shaped so
//   any other state can be added later without a schema change.
//
// Selling preferences (fpoMembershipStatus, liquidityPreference,
// willingToStore, communicationPreference) live directly on FarmerProfile
// rather than a separate FarmerPreferences table — they are 1:1 with the
// farmer with no independent lifecycle of their own, so a second table
// would only add a join every future module (Sell/Store, Market
// Intelligence) would have to repeat for no benefit.
//
// profileCompletionPercentage is deliberately NOT a stored column. It is
// computed on every read from the current farms/crops/preferences state
// (see modules/farmers/completion.ts). Storing it would require every
// farm/crop/preference mutation to remember to recompute and persist it;
// computing on read makes staleness impossible by construction, which is
// what the spec's "frontend must never send this as authoritative" rule
// is ultimately protecting against.
// ---------------------------------------------------------------------------

model State {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())

  districts District[]
  farms     Farm[]
  fpos      Fpo[]

  @@map("states")
}

model District {
  id      String @id @default(uuid())
  stateId String
  name    String

  createdAt DateTime @default(now())

  state   State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  talukas Taluka[]
  farms   Farm[]
  fpos    Fpo[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("districts")
}

model Taluka {
  id         String @id @default(uuid())
  districtId String
  name       String

  createdAt DateTime @default(now())

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  farms    Farm[]
  fpos     Fpo[]

  @@unique([districtId, name])
  @@index([districtId])
  @@map("talukas")
}

// Module 3 — FPO Management & Farmer Aggregation.
//
// Originally a minimal, reference-compatible stub added by Module 2 (build
// spec section 21 there: "only create the relationship required for future
// integration"). Module 3 extends this same model in place — rather than
// creating a second FPO table — with full registration/verification/account
// fields. `id`, `name`, `districtId` and `active` are untouched in meaning;
// every Module 2 query that reads them (reference-data.repository.ts,
// farmers.service.ts's assertFpoExists/getFpoById) keeps working unmodified.
model Fpo {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  name               String
  legalName          String?
  registrationNumber String?
  organizationType   FpoOrganizationType @default(OTHER)

  phone String?
  email String?

  village    String?
  pincode    String?
  latitude   Float?
  longitude  Float?
  stateId    String
  districtId String
  talukaId   String?

  verificationStatus FpoVerificationStatus @default(PENDING)
  accountStatus      FpoAccountStatus      @default(ACTIVE)

  // Legacy Module 2 flag, kept for backward compatibility: Module 2's
  // reference-data listing/selection queries (GET /api/reference/fpos,
  // assertFpoExists, getFpoById) filter on this column directly and must
  // keep working unmodified. Module 3 never writes to it directly — the FPO
  // verification/suspension service methods keep it in sync with
  // `accountStatus === ACTIVE` in the same update (see
  // fpo-verification.service.ts) so both the old and new call sites agree
  // on what "usable" means.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State    @relation(fields: [stateId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  taluka   Taluka?  @relation(fields: [talukaId], references: [id])

  // Module 2's self-declared farmer<->FPO answer (FarmerProfile.fpoId) —
  // unchanged, see that field's own comment for why it is deliberately not
  // merged into Module 3's `memberships` below.
  farmerProfiles FarmerProfile[]

  // Module 3
  admins            FpoAdmin[]
  memberships       FpoMembership[]
  aggregationGroups AggregationGroup[]

  // Module 4 — FPO-admin-created aggregated lots (build spec section 14/
  // 35). Never auto-created from AggregationGroup data — see CropLot's
  // own comment.
  cropLots CropLot[]

  // Module 9 — warehouses owned by this FPO (mirrors User.ownedWarehouses;
  // see WarehouseOwnerType for why exactly one of the two is ever set).
  ownedWarehouses Warehouse[]

  @@index([stateId])
  @@index([districtId])
  @@index([talukaId])
  @@index([verificationStatus])
  @@index([accountStatus])
  @@map("fpos")
}

model Crop {
  id       String  @id @default(uuid())
  // Canonical English name — the stable key other modules and the crop
  // reference API key off. Localized display names live in
  // CropTranslation, never as duplicate Crop rows per language.
  name     String  @unique
  category String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations      CropTranslation[]
  farmerCrops       FarmerCrop[]
  aggregationGroups AggregationGroup[]

  // Module 4. Restrict, not Cascade: a crop reference row must never
  // disappear out from under a historical lot (mirrors FarmerCrop.crop).
  cropLots CropLot[]

  // Module 5 — per-crop grading rules (build spec section 14/48).
  qualityStandards QualityStandard[]

  mandiPrices   MandiPrice[]
  marketAliases CropAlias[]
  buyerDemands  BuyerDemand[]

  // Module 8
  sellStoreDecisions SellStoreDecision[]

  // Module 7 (Price Forecasting)
  priceForecasts PriceForecast[]

  // Module 9 — configured warehouse storage capabilities/rates for this
  // crop. Never AI-generated facts about the crop itself — see
  // WarehouseCropCapability's own comment.
  warehouseCapabilities WarehouseCropCapability[]
  storageRates          StorageRate[]

  @@map("crops")
}

model CropTranslation {
  id            String   @id @default(uuid())
  cropId        String
  language      Language
  localizedName String

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, language])
  @@index([cropId])
  @@map("crop_translations")
}

model FarmerProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Null = the farmer has not yet answered this question (distinct from
  // an explicit "No" / NOT_A_MEMBER), which is what lets the completion
  // calculator and the "missing" list tell "unanswered" apart from
  // "answered in the negative".
  //
  // Module 3 note: this pair remains the farmer's own self-declared answer
  // used only for onboarding/profile-completion (Module 2). It is NOT
  // updated by the FpoMembership approval workflow below and can disagree
  // with it (e.g. a farmer who ticks "MEMBER" here without ever going
  // through FPO admin approval, or an admin-approved member who hasn't
  // touched their profile form). `fpoMemberships` is the authoritative,
  // audited record of admin-approved FPO membership; this pair is not
  // migrated into it so existing profile-completion behavior/tests are
  // left exactly as Module 2 built them (see build spec section 87).
  fpoMembershipStatus FpoMembershipStatus?
  fpoId               String?

  liquidityPreference     LiquidityPreference?
  willingToStore          Boolean?
  communicationPreference CommunicationPreference @default(IN_APP)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fpo         Fpo?         @relation(fields: [fpoId], references: [id], onDelete: SetNull)
  farms       Farm[]
  farmerCrops FarmerCrop[]

  // Module 3 — admin-approved membership history/requests. See the
  // fpoMembershipStatus/fpoId comment above for how this relates to the
  // legacy self-declared fields.
  fpoMemberships FpoMembership[]

  // Module 4 — actual declared produce (never a duplicate of estimated
  // FarmerCrop/aggregation figures, see CropLot's own comment).
  cropLots CropLot[]

  @@index([userId])
  @@index([fpoId])
  @@map("farmer_profiles")
}

model Farm {
  id              String  @id @default(uuid())
  farmerProfileId String
  name            String?

  // Structured location (build spec section 6/13): village is free text,
  // state/district/taluka are normalized FKs so future market-intel and
  // logistics modules can query/aggregate by region reliably. Coordinates
  // are optional and, per section 49, never exposed to buyers or PostHog
  // by this module — only the owning farmer's own requests can read them.
  village    String
  pincode    String?
  latitude   Float?
  longitude  Float?
  stateId    String
  districtId String
  talukaId   String

  area           Float
  areaUnit       AreaUnit
  irrigationType IrrigationType @default(NOT_SPECIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmerProfile FarmerProfile @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  state         State         @relation(fields: [stateId], references: [id])
  district      District      @relation(fields: [districtId], references: [id])
  taluka        Taluka        @relation(fields: [talukaId], references: [id])
  farmerCrops   FarmerCrop[]

  // Module 4 — a farmer-created lot always references the farm it came
  // from (build spec section 17/33). Restrict, not Cascade, on CropLot's
  // side: a farm must never disappear out from under a historical lot.
  cropLots CropLot[]

  @@index([farmerProfileId])
  @@index([stateId])
  @@index([districtId])
  @@index([talukaId])
  @@map("farms")
}

model FarmerCrop {
  id              String @id @default(uuid())
  farmerProfileId String
  farmId          String
  cropId          String

  area      Float
  areaUnit  AreaUnit
  isPrimary Boolean  @default(false)

  // Optional for MVP (build spec section 18).
  typicalYield Float?
  yieldUnit    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmerProfile FarmerProfile @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a crop reference row must never disappear
  // silently out from under a farmer's records just because an admin
  // deactivates/removes a crop from the catalog.
  crop          Crop          @relation(fields: [cropId], references: [id], onDelete: Restrict)

  // One farmer-crop row per (farm, crop) pair — "add Onion to this farm
  // twice" is an edit of the existing row, not a new one (section 44).
  @@unique([farmId, cropId])
  @@index([farmerProfileId])
  @@index([farmId])
  @@index([cropId])
  @@map("farmer_crops")
}

// ---------------------------------------------------------------------------
// Module 3 — FPO Management & Farmer Aggregation
//
// Relationship shape (build spec section 4/101):
//
//   User -> FarmerProfile -> Farm -> FarmerCrop -> FpoMembership -> Fpo
//                                                                     |
//                                                    +----------------+----------------+
//                                                    v                                 v
//                                            Member management                  Aggregation
//                                                                                     |
//                                                                                     v
//                                                                          AggregationGroup (planning
//                                                                          object only — never a sale,
//                                                                          order, contract, lot or
//                                                                          shipment; see section 75)
// ---------------------------------------------------------------------------

// An authorization grant: "this user administers this FPO". FPO_ADMIN alone
// (the User.role) never grants access to a specific FPO — every FPO-scoped
// admin operation must find an ACTIVE row here for (userId, fpoId) first.
// See modules/fpo/fpo.authorization.ts.
model FpoAdmin {
  id     String @id @default(uuid())
  fpoId  String
  userId String

  role   FpoAdminRole
  status FpoAdminStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fpo  Fpo  @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fpoId, userId])
  @@index([userId])
  @@index([fpoId])
  @@map("fpo_admins")
}

// A single farmer's membership request/record at one FPO. Historical rows
// (REJECTED/REMOVED) are never deleted — see build spec section 19/93.
//
// Build spec section 14: a farmer may hold only one ACTIVE primary FPO
// membership at a time. This is enforced server-side in
// membership.service.ts (checked inside the same operation that creates/
// approves a membership). PostgreSQL can additionally enforce it at the
// database level with a *partial* unique index, which Prisma's schema DSL
// cannot express declaratively:
//
//   CREATE UNIQUE INDEX fpo_memberships_one_active_per_farmer
//     ON fpo_memberships (farmer_id)
//     WHERE status = 'ACTIVE';
//
// Apply this by hand in a follow-up migration (`prisma migrate dev
// --create-only`, then add the statement above) once a real database is
// available — the plain @@index below only supports lookups, not the
// uniqueness constraint.
model FpoMembership {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  fpoId    String
  farmerId String

  status MembershipStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  joinedAt    DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  removedAt   DateTime?

  // Optional admin-facing note captured on reject (build spec section 18).
  // Never returned to the farmer as "internal notes" — only a plain
  // rejection reason string is surfaced, see membership.types.ts.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fpo    Fpo           @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  farmer FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([fpoId, status])
  @@index([farmerId, status])
  @@map("fpo_memberships")
}

// A planning target for one crop at one FPO (build spec section 34/75/94:
// "not a sale, order, contract, lot, or shipment"). Future Module 4 will
// hang actual Lot rows off this via aggregationGroupId; none of that exists
// yet (section 40/96 — no fake lotId).
model AggregationGroup {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  fpoId  String
  cropId String

  targetQuantity    Float?
  // Snapshot of the estimated member supply *at creation/last recompute
  // time* — the live figure always comes from FpoAggregationService at read
  // time (build spec section 73: data freshness); this column exists so a
  // closed/cancelled group still shows what supply looked like when it was
  // open, without depending on farmer data that may since have changed.
  estimatedQuantity Float?
  unit              QuantityUnit @default(QTL)

  status AggregationGroupStatus @default(DRAFT)

  targetDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fpo  Fpo  @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  crop Crop @relation(fields: [cropId], references: [id], onDelete: Restrict)

  @@index([fpoId, status])
  @@index([cropId])
  @@index([status])
  @@map("aggregation_groups")
}

// ---------------------------------------------------------------------------
// Module 4 — Crop / Lot Management
//
// Relationship shape (build spec section 33/87):
//
//   FarmerProfile -> Farm -> FarmerCrop -> CropLot
//   Fpo -> CropLot (FPO-owned/aggregated lot, admin-created only)
//
// Core distinction this module exists to enforce (build spec section 54/
// 88/102): FarmerCrop is "I grow onion" (Module 2), AggregationGroup/
// crop-aggregation is "our members are estimated to have N QTL" (Module 3,
// a planning target, never inventory), and CropLot is "I have created this
// actual N QTL lot for downstream use" — the first real transactional
// object in the system. A lot is never auto-created from FarmerCrop or
// AggregationGroup data; the farmer/FPO admin must explicitly create it
// (section 15/36/88).
// ---------------------------------------------------------------------------

// A real, farmer/FPO-declared quantity of produce (build spec section 5/6).
// Quantities are stored as Decimal (not Float, unlike Module 2/3's
// area/estimatedQuantity columns) because a lot is the actual transactional
// record future Sell/Store, Warehouse and Payment modules will do
// arithmetic against — see build spec section 65/83 and lots.repository.ts'
// own comment on why the KG/QTL/TONNE conversion service still exposes
// plain `number` to the rest of the application above the repository
// boundary.
model CropLot {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  // Human-facing reference (build spec section 10), e.g. "LOT-2026-000123".
  // Server-generated only — see lots/lot-number.ts — never accepted from
  // the client, stable for the lifetime of the lot. publicId above remains
  // the API identity used in URLs (build spec section 48).
  lotNumber String @unique

  ownerType  LotOwnerType
  sourceType LotSourceType

  // Exactly one of farmerId/fpoId is set, matching ownerType — enforced in
  // lots.service.ts, never trusted from request body (build spec section
  // 13/49/50). Restrict (not Cascade/SetNull): a farmer/FPO record must
  // never disappear out from under a historical transactional lot.
  farmerId String?
  fpoId    String?

  cropId String
  // Only set for a farmer-created lot (build spec section 6/17) — an
  // FPO-owned lot has no single owning Farm.
  farmId String?

  variety String?

  // Internal source of truth, always KG (build spec section 11/65).
  // `unit` below is only the unit the lot was originally created/displayed
  // in — never re-derived arithmetic.
  unit                QuantityUnit @default(KG)
  quantityKg          Decimal      @db.Decimal(14, 2)
  availableQuantityKg Decimal      @db.Decimal(14, 2)

  harvestDate      DateTime?
  availabilityDate DateTime

  // Origin snapshot (build spec section 17/18/55): copied from the farm
  // (or, for an FPO-owned lot, the FPO's own registered location) at
  // creation time and never re-derived — so a later edit to the farm/FPO's
  // profile can't silently rewrite a historical lot's recorded origin.
  originVillage  String?
  originTaluka   String?
  originDistrict String
  originState    String

  status CropLotStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer FarmerProfile? @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  fpo    Fpo?           @relation(fields: [fpoId], references: [id], onDelete: Restrict)
  crop   Crop           @relation(fields: [cropId], references: [id], onDelete: Restrict)
  farm   Farm?          @relation(fields: [farmId], references: [id], onDelete: Restrict)

  statusHistory LotStatusHistory[]

  // Module 5 — every quality assessment ever created for this lot,
  // oldest first by createdAt; never deleted when superseded (build spec
  // section 31/32/70: historical assessments must survive for future
  qualityAssessments QualityAssessment[]
  tradeOffers        TradeOffer[]

  // Module 8
  sellStoreDecisions SellStoreDecision[]

  // Module 9 — every storage reservation ever created against this lot
  // (foundation only in Part 1: no reservation actually adjusts
  // availableQuantityKg yet — see StorageReservation's own comment).
  storageReservations StorageReservation[]

  @@index([farmerId, status])
  @@index([fpoId, status])
  @@index([cropId, status])
  @@index([farmId])
  @@index([status])
  @@index([availabilityDate])
  @@index([createdAt])
  @@map("crop_lots")
}

// Append-only transition log (build spec section 37/38/69) — kept
// alongside CropLot.status rather than relied on instead of it, so "what is
// this lot's status right now" is always a single indexed column read, and
// "how did it get there" is a separate, never-mutated history.
model LotStatusHistory {
  id    String @id @default(uuid())
  lotId String

  // Null fromStatus represents the initial DRAFT row created alongside the
  // lot itself (build spec section 69 example: `"from": null, "to": "DRAFT"`).
  fromStatus CropLotStatus?
  toStatus   CropLotStatus

  changedBy String?
  reason    String?

  createdAt DateTime @default(now())

  lot           CropLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  changedByUser User?   @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@index([createdAt])
  @@map("lot_status_history")
}

// ---------------------------------------------------------------------------
// Module 5 — Quality Grading & Produce Assessment
//
// Core product principle (build spec section 82): "how good is this lot,
// and how confidently do we know that?" A farmer's self-report, an AI
// estimate, an inspector's manual verification and a lab result are never
// merged into one number — each is its own QualityAssessment row, kept
// forever (build spec section 31/32/70: quality data must be historical
// and immutable after verification, for future dispute-resolution
// modules). AI output is never the source of truth on its own (build spec
// section 6/72): it starts as AI_ESTIMATED and only becomes VERIFIED
// through an explicit human verification step.
// ---------------------------------------------------------------------------

enum QualityAssessmentSource {
  MANUAL
  AI
  LAB
  HYBRID
}

// Build spec section 9 plus FAILED (section 21/67 explicitly requires a
// PROCESSING -> FAILED edge for a failed AI provider call, which the
// suggested enum in section 9 omitted).
enum QualityAssessmentStatus {
  DRAFT
  PENDING_IMAGES
  PROCESSING
  AI_COMPLETED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
  FAILED
}

// Build spec section 10: general grades; crop-specific grading rules live
// in QualityStandard below rather than in this enum.
enum QualityGrade {
  A
  B
  C
  D
  REJECTED
}

enum QualityMetricSource {
  MANUAL
  AI
  LAB
}

enum QualityImageType {
  OVERVIEW
  TOP_VIEW
  SIDE_VIEW
  CLOSE_UP
  DEFECT
  OTHER
}

// Build spec section 28/49: how much trust a grade carries — never
// conflated with QualityAssessmentStatus (a status tracks *workflow*
// position; this tracks *trust level*, and only this is safe to surface to
// a buyer as "how certain is this").
enum QualityVerificationStatus {
  SELF_REPORTED
  AI_ESTIMATED
  VERIFIED
  LAB_VERIFIED
}

enum QualityDefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Build spec section 38: one row per AI attempt (including retries, build
// spec section 39) rather than one mutable job — see QualityAIAnalysis's
// own comment.
enum QualityAIAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

//
// The record of one assessment event (build spec section 7). A lot can
// have many of these over time — see the model-level comment above this
// section. `qualityScore` (0-100, produce condition) and `confidenceScore`
// (0-1, AI certainty) are deliberately separate columns (build spec
// section 46) — a manual/lab assessment has no confidenceScore at all.
// /
model QualityAssessment {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  lotId String

  // Human-facing reference, e.g. "QA-2026-000001" (build spec section 57)
  // — server-generated, immutable, never accepted from the client. Mirrors
  // CropLot.lotNumber (see lots/lot-number.ts) — see quality/assessment-number.ts.
  assessmentNumber String @unique

  source             QualityAssessmentSource
  status             QualityAssessmentStatus   @default(DRAFT)
  verificationStatus QualityVerificationStatus @default(SELF_REPORTED)

  overallGrade    QualityGrade?
  qualityScore    Decimal?      @db.Decimal(5, 2)
  confidenceScore Decimal?      @db.Decimal(4, 3)

  // Who submitted (for MANUAL/HYBRID) or most recently verified this
  // assessment — informational/audit-trail only, deliberately a plain
  // column rather than a Prisma relation (build spec section 27's
  // multi-role actor set — farmer, FPO admin, admin, future inspector —
  // isn't worth three more User back-relations for a field nothing in
  // this module joins against).
  assessedByUserId String?
  assessedAt       DateTime?

  // Build spec section 33: when a later assessment supersedes this one,
  // point forward to it. The superseding assessment is never itself
  // deleted or mutated to "become" this one — both rows persist.
  supersededByAssessmentId String?            @unique
  supersededBy             QualityAssessment? @relation("AssessmentSupersession", fields: [supersededByAssessmentId], references: [id], onDelete: SetNull)
  supersedes               QualityAssessment? @relation("AssessmentSupersession")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lot        CropLot             @relation(fields: [lotId], references: [id], onDelete: Restrict)
  metrics    QualityMetric[]
  images     QualityImage[]
  defects    QualityDefect[]
  aiAnalyses QualityAIAnalysis[]

  @@index([lotId, createdAt])
  @@index([lotId, status])
  @@index([status])
  @@index([source])
  @@index([overallGrade])
  @@map("quality_assessments")
}

//
// Flexible per-crop metrics (build spec section 11-13) — never columns
// like `moisture`/`damage`/`color` directly on QualityAssessment, so a new
// metric for a new crop never needs a migration.
// /
model QualityMetric {
  id           String @id @default(uuid())
  assessmentId String

  metricCode String
  metricName String

  value Decimal @db.Decimal(10, 2)
  unit  String?

  minAllowed Decimal? @db.Decimal(10, 2)
  maxAllowed Decimal? @db.Decimal(10, 2)

  source QualityMetricSource

  createdAt DateTime @default(now())

  assessment QualityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([metricCode])
  @@map("quality_metrics")
}

//
// Image metadata only (build spec section 15: "Do not store binary image
// data in PostgreSQL"). `storageProvider`/`externalId` are deliberately
// generic rather than Cloudinary-specific columns — this codebase has no
// Cloudinary (or any) file-storage integration yet (see
// images/quality-image.service.ts's own comment on why), so the schema is
// written to accept whichever provider is wired in first without another
// migration.
// /
model QualityImage {
  id           String @id @default(uuid())
  assessmentId String

  storageProvider String
  externalId      String
  secureUrl       String
  // Build spec section 41: optional foundation for future same-image
  // analysis-result caching — not used for any dedup logic yet.
  checksum        String?

  imageType        QualityImageType @default(OTHER)
  uploadedByUserId String?

  uploadedAt DateTime @default(now())

  assessment QualityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("quality_images")
}

//
// Build spec section 44-45: defects are their own flexible rows for the
// same reason metrics are — never crop-specific columns.
// /
model QualityDefect {
  id           String @id @default(uuid())
  assessmentId String

  code String
  name String

  severity QualityDefectSeverity

  affectedPercentage Decimal? @db.Decimal(5, 2)
  confidence         Decimal? @db.Decimal(4, 3)

  createdAt DateTime @default(now())

  assessment QualityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("quality_defects")
}

//
// One row per AI analysis *attempt* (build spec section 38-39/42-43) —
// including retries — rather than a single mutable "the AI result" field,
// so a retry after a FAILED attempt never destroys the failure record.
// `rawResultJson` only ever holds the sanitized, normalized
// QualityAnalysisResult shape (see ai/quality-ai.types.ts) — never a raw
// provider payload (build spec section 22/43: "Do not expose
// provider-specific raw JSON directly").
// /
model QualityAIAnalysis {
  id           String @id @default(uuid())
  assessmentId String

  provider     String
  modelVersion String

  status QualityAIAnalysisStatus @default(QUEUED)

  confidenceScore Decimal? @db.Decimal(4, 3)
  rawResultJson   Json?

  requestedByUserId String?
  requestedAt       DateTime  @default(now())
  processedAt       DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment QualityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@index([status])
  @@map("quality_ai_analyses")
}

//
// Build spec section 14/48: a clean, additive per-crop grading foundation
// — deliberately NOT a full rules engine (boolean expressions, AND/OR
// trees, etc.), just "for this crop, this grade requires this metric to
// fall in this range". QualityGradingService reads these rows to turn a
// set of QualityMetric values into a QualityGrade; if no QualityStandard
// rows exist for a crop, grading falls back to whatever grade was
// supplied directly (manual/AI-suggested) — see that service's comment.
// /
model QualityStandard {
  id     String @id @default(uuid())
  cropId String

  grade      QualityGrade
  metricCode String

  minValue Decimal? @db.Decimal(10, 2)
  maxValue Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, grade, metricCode])
  @@index([cropId])
  @@map("quality_standards")
}

// ---------------------------------------------------------------------------
// Module 6 — Market data & price discovery
// ---------------------------------------------------------------------------

enum MarketImportOperation {
  HISTORICAL_IMPORT
  INCREMENTAL_SYNC
}

enum MarketImportStatus {
  RUNNING
  SUCCEEDED
  PARTIAL_SUCCESS
  FAILED
  SKIPPED
}

// A source market. Location is deliberately optional: it is never guessed.
model Mandi {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  source         String
  sourceMarketId String?
  name           String
  normalizedName String
  state          String
  district       String
  latitude       Float?
  longitude      Float?
  sourceMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices MandiPrice[]

  // Module 7 (Price Forecasting) — only set for MANDI-scoped forecasts.
  priceForecasts PriceForecast[]

  @@unique([source, sourceMarketId])
  @@unique([source, normalizedName, district, state])
  @@index([state, district])
  @@index([latitude, longitude])
  @@map("mandis")
}

// Canonical, date-wise historical price data. Monetary values are INR/QTL.
model MandiPrice {
  id             String   @id @default(uuid())
  cropId         String
  mandiId        String
  source         String
  sourceRecordId String?
  observedDate   DateTime @db.Date

  minPrice        Decimal       @db.Decimal(14, 2)
  maxPrice        Decimal       @db.Decimal(14, 2)
  modalPrice      Decimal       @db.Decimal(14, 2)
  arrivalQuantity Decimal?      @db.Decimal(14, 2)
  arrivalUnit     QuantityUnit?
  sourceMetadata  Json?
  retrievedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  crop  Crop  @relation(fields: [cropId], references: [id], onDelete: Restrict)
  mandi Mandi @relation(fields: [mandiId], references: [id], onDelete: Restrict)

  @@unique([cropId, mandiId, observedDate, source])
  @@unique([source, sourceRecordId])
  @@index([cropId, observedDate])
  @@index([mandiId, observedDate])
  @@index([cropId, mandiId, observedDate])
  @@map("mandi_prices")
}

// Explicit aliases prevent an importer from inventing a Crop record.
model CropAlias {
  id              String   @id @default(uuid())
  cropId          String
  source          String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([source, normalizedAlias])
  @@index([cropId])
  @@map("crop_aliases")
}

// Durable, non-sensitive operational record for import and sync attempts.
model MarketDataImportRun {
  id                 String                @id @default(uuid())
  source             String
  operation          MarketImportOperation
  status             MarketImportStatus    @default(RUNNING)
  recordsRead        Int                   @default(0)
  recordsImported    Int                   @default(0)
  recordsUpdated     Int                   @default(0)
  recordsSkipped     Int                   @default(0)
  recordsRejected    Int                   @default(0)
  validationFailures Int                   @default(0)
  partialFailures    Int                   @default(0)
  diagnostics        Json?
  metadata           Json?
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  createdAt          DateTime              @default(now())

  @@index([source, operation, startedAt])
  @@map("market_data_import_runs")
}

// Progress is advanced only after a page/range was persisted successfully.
model MarketDataSyncCheckpoint {
  id                         String    @id @default(uuid())
  source                     String    @unique
  lastSuccessfulObservedDate DateTime? @db.Date
  cursor                     String?
  metadata                   Json?
  lastSuccessfulSyncAt       DateTime?
  updatedAt                  DateTime  @updatedAt

  @@map("market_data_sync_checkpoints")
}

// Module 7 — buyer discovery, matching and immutable digital offers.
enum BuyerBusinessType {
  PROCESSOR
  WHOLESALER
  RETAILER
  EXPORTER
  INSTITUTIONAL_BUYER
  TRADER
  OTHER
}

enum BuyerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BuyerDemandStatus {
  DRAFT
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum TradeOfferStatus {
  DRAFT
  SENT
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

model BuyerProfile {
  id                 String                  @id @default(uuid())
  publicId           String                  @unique @default(uuid())
  userId             String                  @unique
  organizationName   String
  businessType       BuyerBusinessType
  description        String?
  contactPerson      String
  phone              String
  email              String?
  address            String?
  state              String
  district           String
  latitude           Float?
  longitude          Float?
  website            String?
  verificationStatus BuyerVerificationStatus @default(PENDING)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  demands            BuyerDemand[]
  buyerOffers        TradeOffer[]            @relation("OfferBuyer")

  @@index([verificationStatus])
  @@index([state, district])
  @@map("buyer_profiles")
}

model BuyerDemand {
  id                  String            @id @default(uuid())
  publicId            String            @unique @default(uuid())
  buyerId             String
  cropId              String
  title               String
  description         String?
  requiredQuantity    Decimal           @db.Decimal(14, 2)
  minimumQuantity     Decimal?          @db.Decimal(14, 2)
  quantityUnit        QuantityUnit
  targetPrice         Decimal?          @db.Decimal(14, 2)
  minimumPrice        Decimal?          @db.Decimal(14, 2)
  maximumPrice        Decimal?          @db.Decimal(14, 2)
  qualityRequirements Json?
  grade               QualityGrade?
  state               String
  district            String
  latitude            Float?
  longitude           Float?
  deliveryLocation    String?
  deliveryStartDate   DateTime?
  deliveryEndDate     DateTime?
  status              BuyerDemandStatus @default(DRAFT)
  committedQuantity   Decimal           @default(0) @db.Decimal(14, 2)
  expiresAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  buyer               BuyerProfile      @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  crop                Crop              @relation(fields: [cropId], references: [id], onDelete: Restrict)
  offers              TradeOffer[]

  @@index([buyerId, status])
  @@index([cropId, status])
  @@index([status, expiresAt])
  @@map("buyer_demands")
}

model TradeOffer {
  id            String               @id @default(uuid())
  publicId      String               @unique @default(uuid())
  lotId         String
  buyerDemandId String?
  buyerId       String
  sellerId      String
  initiatorId   String
  quantity      Decimal              @db.Decimal(14, 2)
  quantityUnit  QuantityUnit
  offeredPrice  Decimal              @db.Decimal(14, 2)
  priceUnit     String               @default("INR_PER_QUINTAL")
  totalValue    Decimal              @db.Decimal(16, 2)
  deliveryTerms String?
  message       String?
  status        TradeOfferStatus     @default(DRAFT)
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  lot           CropLot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  demand        BuyerDemand?         @relation(fields: [buyerDemandId], references: [id], onDelete: SetNull)
  buyer         BuyerProfile         @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  revisions     TradeOfferRevision[]

  @@index([lotId, status])
  @@index([buyerId, status])
  @@index([buyerDemandId, status])
  @@map("trade_offers")
}

model TradeOfferRevision {
  id             String     @id @default(uuid())
  offerId        String
  revisionNumber Int
  initiatedBy    String
  quantity       Decimal    @db.Decimal(14, 2)
  offeredPrice   Decimal    @db.Decimal(14, 2)
  priceUnit      String     @default("INR_PER_QUINTAL")
  deliveryTerms  String?
  message        String?
  createdAt      DateTime   @default(now())
  offer          TradeOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, revisionNumber])
  @@index([offerId, createdAt])
  @@map("trade_offer_revisions")
}

// ---------------------------------------------------------------------------
// Module 8 — Sell vs Store Decision Engine
// ---------------------------------------------------------------------------

enum SellStoreDecisionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SellStoreDecisionResult {
  SELL_NOW
  STORE
  INSUFFICIENT_DATA
}

model SellStoreDecision {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  lotId  String
  cropId String

  requestedByUserId String?

  status SellStoreDecisionStatus  @default(PENDING)
  result SellStoreDecisionResult?

  confidenceScore Decimal? @db.Decimal(5, 4)

  // Immutable snapshot of inputs used during the decision (Market, Lot, Storage context).
  inputSnapshot Json?

  // Metadata explaining the decision (engine version, scores, factors used, reasons).
  decisionMetadata Json?

  marketDataTimestamp  DateTime?
  storageDataTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lot             CropLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  crop            Crop    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  requestedByUser User?   @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([lotId, status])
  @@index([requestedByUserId])
  @@map("sell_store_decisions")
}

// ---------------------------------------------------------------------------
// Module 7 — Price Forecasting: foundation & data model (Part 1)
//
// This part deliberately persists forecasts only — it does not generate
// them. MandiPrice (Module 6) remains the single authoritative source of
// historical price observations; PriceForecast never copies or duplicates
// that history, it only records what a (future) forecasting run predicted
// from it. See docs/modules/module-07-price-forecasting.md.
// ---------------------------------------------------------------------------

// What a forecast is predicting a price *for*. A forecast is always
// generated for a single crop, plus exactly one of:
//   MANDI      — one specific market (mandiId is set)
//   REGIONAL   — a state, optionally narrowed to a district (regionState /
//                regionDistrict are set, mandiId is null)
//   CROP_WIDE  — the crop everywhere (no mandi/region set at all)
// scopeType is stored explicitly (rather than only inferred from which
// columns are null) so queries/branches never have to reverse-engineer
// scope from null-checks, and so the meaning of "null mandiId" can never
// silently drift.
enum PriceForecastScopeType {
  MANDI
  REGIONAL
  CROP_WIDE
}

// Deliberately its own enum rather than reusing SellStoreDecisionStatus
// (Module 8) — that one has no GENERATING/INSUFFICIENT_DATA distinction a
// forecast run needs, and the two lifecycles have nothing in common beyond
// both being "did this computation finish OK".
enum PriceForecastStatus {
  GENERATING
  COMPLETED
  FAILED
  INSUFFICIENT_DATA
}

// A single generated price prediction, persisted for reuse. Money fields
// use Decimal (matching MandiPrice's INR/QTL convention, see that model's
// comment) — never Float, so downstream arithmetic (Sell vs Store, future
// UI) never inherits floating-point rounding error.
//
// Idempotency: a duplicate forecast for the same crop + scope + target
// date + model version must not create a conflicting second row (build
// spec requirement). A nullable mandiId/regionState/regionDistrict cannot
// enforce that alone — Postgres unique indexes treat NULL as distinct from
// NULL, so two CROP_WIDE rows (mandiId = NULL for both) would not collide.
// `scopeKey` is a deterministic, NULL-free string encoding of scopeType +
// its scope columns (built by modules/price-forecasting's scope helpers,
// e.g. "MANDI:<mandiId>", "REGIONAL:<state>:<district|*>", "CROP_WIDE"),
// and the unique constraint is keyed on it instead.
model PriceForecast {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  cropId String
  crop   Crop   @relation(fields: [cropId], references: [id], onDelete: Restrict)

  scopeType PriceForecastScopeType

  // Set only when scopeType = MANDI. Restrict: a mandi reference row must
  // never disappear out from under a historical forecast.
  mandiId String?
  mandi   Mandi?  @relation(fields: [mandiId], references: [id], onDelete: Restrict)

  // Set only when scopeType = REGIONAL. regionDistrict is optional even
  // within REGIONAL scope (a state-wide forecast has no district).
  regionState    String?
  regionDistrict String?

  // See model comment — the collision-safe encoding of the three fields
  // above, and what idempotency is actually enforced against.
  scopeKey String

  targetDate  DateTime @db.Date
  horizonDays Int

  predictedPrice  Decimal  @db.Decimal(14, 2)
  lowerBound      Decimal? @db.Decimal(14, 2)
  upperBound      Decimal? @db.Decimal(14, 2)
  // 0-1 scale, matching Module 8's confidenceScore convention.
  confidenceScore Decimal? @db.Decimal(4, 3)

  status PriceForecastStatus @default(GENERATING)

  // Free-text identifiers (not an enum) so a new model/provider never
  // needs a migration — mirrors MandiPrice.source being a plain string for
  // the same reason.
  modelProvider String
  modelVersion  String

  // The historical window the (future) forecasting run actually read from
  // MandiPrice to produce this prediction — an audit trail, never a second
  // copy of the prices themselves.
  inputDataStartDate DateTime? @db.Date
  inputDataEndDate   DateTime? @db.Date
  sampleCount        Int?

  generatedAt DateTime  @default(now())
  // A forecast past this timestamp is stale and should not be served as
  // "latest valid" (see PriceForecastRepository.findLatestValid) — never
  // auto-deleted, just excluded from that query.
  expiresAt   DateTime?

  // Safe, technical-only metadata (e.g. algorithm parameters, feature
  // flags used) — never raw provider payloads or PII, mirroring
  // QualityAIAnalysis.rawResultJson's own "sanitized, normalized shape
  // only" rule.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cropId, scopeKey, targetDate, modelVersion])
  @@index([cropId, targetDate])
  @@index([cropId, mandiId, targetDate])
  @@index([status])
  @@index([expiresAt])
  @@map("price_forecasts")
}

// ---------------------------------------------------------------------------
// Module 9 — Warehouse Intelligence
// Part 1: Foundation & Data Model
//
// Scope of this part: the domain model + repository layer only. No APIs,
// controllers, routes, capacity-allocation logic, cost calculation, or
// integration with Module 8 (Sell vs Store) yet — see the repository
// interfaces in warehouse-intelligence/ for exactly which operations
// exist today.
//
// Relationship shape:
//
//   User / Fpo (exactly one, see WarehouseOwnerType)
//     └── Warehouse
//           ├── WarehouseStorageUnit[]      — chambers/sections
//           ├── WarehouseCropCapability[]   — configured, not AI-derived
//           ├── StorageReservation[]        — foundation only, no capacity
//           │                                 math yet (see model comment)
//           └── StorageRate[]               — configured pricing, no cost
//                                              calculation yet
//
//   CropLot ── StorageReservation[]
//   Crop    ── WarehouseCropCapability[], StorageRate[]
// ---------------------------------------------------------------------------

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Who owns this warehouse — deliberately its own enum, mirroring
// LotOwnerType's rationale: "who owns this warehouse" is unrelated to any
// other lifecycle enum, and exactly one of ownerUserId/ownerFpoId is set
// to match. Not enforced at the database level (Postgres has no portable
// XOR-on-two-nullable-columns constraint that matches the rest of this
// project's conventions) — enforced in the future service layer the same
// way CropLot's farmerId/fpoId pairing is, never trusted from the request
// body.
enum WarehouseOwnerType {
  USER
  FPO
}

// Shared between Warehouse.warehouseType (what kind of facility this is
// overall) and WarehouseStorageUnit.storageType (what kind of storage a
// specific chamber/section provides) — one enum rather than two near-
// identical ones, per the "do not create redundant enums" instruction.
enum StorageType {
  AMBIENT
  COLD_STORAGE
  CONTROLLED_ATMOSPHERE
  SILO
  WAREHOUSE_GODOWN
  OTHER
}

// Configured compatibility, not a computed/AI-derived fact (build spec for
// this part: "represent configured capabilities, not AI-generated facts").
enum CropStorageCompatibility {
  COMPATIBLE
  NOT_RECOMMENDED
  INCOMPATIBLE
}

enum StorageReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum StorageRateType {
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_QUANTITY_PER_DAY
}

model Warehouse {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  ownerType   WarehouseOwnerType
  ownerUserId String?
  ownerFpoId  String?

  name          String
  warehouseType StorageType @default(AMBIENT)

  state   String
  district String
  address String?

  latitude  Float?
  longitude Float?

  // Reuses Module 1's VerificationStatus (PENDING/VERIFIED/REJECTED/
  // EXPIRED) rather than a bespoke warehouse enum — "verification should
  // not be fabricated if a reusable enum already exists".
  verificationStatus VerificationStatus @default(PENDING)

  // status is the lifecycle enum (ACTIVE/INACTIVE/SUSPENDED — the only
  // one of the two that can express "an admin suspended this warehouse").
  // isActive is a fast, denormalized listing/filter flag in the same
  // spirit as Fpo.active — kept in sync with status by the future service
  // layer, never derived automatically inside this repository layer.
  status   WarehouseStatus @default(ACTIVE)
  isActive Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, not Cascade/SetNull: an owning user/FPO record must never
  // disappear out from under a warehouse record, mirroring CropLot's
  // farmer/fpo relations.
  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  ownerFpo  Fpo?  @relation(fields: [ownerFpoId], references: [id], onDelete: Restrict)

  storageUnits WarehouseStorageUnit[]
  capabilities WarehouseCropCapability[]
  reservations StorageReservation[]
  rates        StorageRate[]

  @@index([ownerUserId])
  @@index([ownerFpoId])
  @@index([state, district])
  @@index([status])
  @@index([verificationStatus])
  @@index([createdAt])
  // Module 9 Part 2 — supports the nearby-warehouse bounding-box query
  // (WarehouseRepository.findNearbyCandidates) the same way Mandi never
  // needed one: Module 6 never bounded its candidate set in SQL (it loads
  // every market row — see market-intelligence.repository.ts's own
  // comment trail), but this part's explicit "avoid loading every
  // warehouse in the database" requirement means the box filter runs in
  // the WHERE clause here, so it needs an index to stay a seek rather
  // than a scan as the warehouses table grows.
  @@index([latitude, longitude])
  @@map("warehouses")
}

model WarehouseStorageUnit {
  id          String @id @default(uuid())
  publicId    String @unique @default(uuid())
  warehouseId String

  // Short human-facing section/chamber label, e.g. "Chamber A" or "CS-1" —
  // unique per warehouse, not globally (a farmer/buyer only ever sees it
  // in the context of its warehouse).
  code        String
  storageType StorageType @default(AMBIENT)

  // Capacity is Decimal, never floating-point (this part's explicit data
  // integrity requirement) — mirrors CropLot.quantityKg/
  // availableQuantityKg's own Decimal(14,2) convention.
  totalCapacity     Decimal      @db.Decimal(14, 2)
  availableCapacity Decimal      @db.Decimal(14, 2)
  capacityUnit      QuantityUnit @default(KG)

  temperatureControlled Boolean  @default(false)
  minTemperature        Decimal? @db.Decimal(5, 2)
  maxTemperature        Decimal? @db.Decimal(5, 2)

  humidityControlled Boolean  @default(false)
  minHumidity        Decimal? @db.Decimal(5, 2)
  maxHumidity        Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade here (unlike the Restrict used for reservations/rates below):
  // a storage unit is a physical sub-component of its warehouse with no
  // independent lifecycle, whereas reservations and rates are
  // transactional/historical records that must never silently vanish.
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  capabilities WarehouseCropCapability[]
  reservations StorageReservation[]
  rates        StorageRate[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([storageType])
  @@map("warehouse_storage_units")
}

// Configured "can crop X be stored here" capability — a plain join/config
// table (no publicId, matching FarmerCrop's convention for this kind of
// row) rather than a computed or AI-inferred fact.
model WarehouseCropCapability {
  id String @id @default(uuid())

  warehouseId String
  // Optional narrower scope: null means "applies warehouse-wide", a set
  // value means "applies only to this specific storage unit". Note:
  // Postgres composite unique indexes do not deduplicate across NULLs, so
  // @@unique below only prevents duplicates for a given concrete
  // storageUnitId — preventing a duplicate warehouse-wide (storageUnitId
  // null) row for the same crop is left to the future service layer, the
  // same way ownerType/ownerUserId/ownerFpoId pairing is.
  storageUnitId String?
  cropId        String

  compatibility CropStorageCompatibility @default(COMPATIBLE)

  // Optional configured guidance, never computed here (this part's
  // explicit "do not invent scientific storage conditions" instruction).
  maxStorageDurationDays       Int?
  storageConditions            String?
  estimatedSpoilageRatePercent Decimal? @db.Decimal(5, 2)

  metadata Json?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  storageUnit WarehouseStorageUnit? @relation(fields: [storageUnitId], references: [id], onDelete: Cascade)
  // Restrict: a crop reference row must never disappear out from under a
  // configured capability, mirroring FarmerCrop.crop/CropLot.crop.
  crop        Crop                  @relation(fields: [cropId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, storageUnitId, cropId])
  @@index([warehouseId])
  @@index([storageUnitId])
  @@index([cropId])
  @@map("warehouse_crop_capabilities")
}

// Foundation only (this part's explicit scope limit): a record that
// capacity is intended to be reserved, not an atomic capacity-allocation
// mechanism. Nothing decrements WarehouseStorageUnit.availableCapacity in
// Part 1 — that concurrency-safe transaction is future work, mirroring how
// CropLot.adjustAvailableQuantity() was itself built as a guarded atomic
// primitive only once it was actually wired to a caller.
model StorageReservation {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  warehouseId    String
  storageUnitId  String?
  lotId          String

  quantity Decimal      @db.Decimal(14, 2)
  unit     QuantityUnit @default(KG)

  status StorageReservationStatus @default(PENDING)

  reservedFrom  DateTime
  reservedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict throughout: a reservation is a transactional record that must
  // never disappear out from under its warehouse, storage unit, or lot.
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageUnit WarehouseStorageUnit? @relation(fields: [storageUnitId], references: [id], onDelete: Restrict)
  lot         CropLot               @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([warehouseId, status])
  @@index([storageUnitId, status])
  @@index([lotId])
  @@index([status])
  @@index([reservedFrom])
  @@index([reservedUntil])
  @@map("storage_reservations")
}

// Foundation only: configured pricing data. No cost calculation happens
// here or anywhere in Part 1 — that reads these rows in a future part.
model StorageRate {
  id       String @id @default(uuid())
  publicId String @unique @default(uuid())

  warehouseId   String
  storageUnitId String?
  // Null means "applies to any crop at this warehouse/unit" — a specific
  // crop row overrides it (resolution order is future-part logic; this
  // part only stores the rows).
  cropId        String?

  rateType   StorageRateType
  rateAmount Decimal         @db.Decimal(10, 2)
  // No other model in this schema carries a currency column (the project
  // is INR-only) — kept here anyway since the spec for this part calls
  // for it explicitly; defaults to "INR" so every existing/future query
  // can still assume INR without reading this column.
  currency   String          @default("INR")
  billingUnit QuantityUnit   @default(KG)

  effectiveFrom  DateTime
  effectiveUntil DateTime?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageUnit WarehouseStorageUnit? @relation(fields: [storageUnitId], references: [id], onDelete: Restrict)
  crop        Crop?                 @relation(fields: [cropId], references: [id], onDelete: Restrict)

  @@index([warehouseId, isActive])
  @@index([storageUnitId])
  @@index([cropId])
  @@index([effectiveFrom, effectiveUntil])
  @@map("storage_rates")
}
